[node name="Center" type="CenterContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2

[node name="Panel" type="PanelContainer" parent="Center"]
custom_minimum_size = Vector2(440, 420)
layout_mode = 2
theme_override_styles/panel = SubResource("paper")

[node name="Column" type="VBoxContainer" parent="Center/Panel"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="Heading" type="Label" parent="Center/Panel/Column"]
layout_mode = 2
theme_type_variation = &"PaperLabel"
theme_override_font_sizes/font_size = 26
text = "Load save"
horizontal_alignment = 1

[node name="SaveEmpty" type="Label" parent="Center/Panel/Column"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"PaperMuted"
text = "No zoos saved yet."
