[gd_scene load_steps=4 format=3]

[ext_resource type="Theme" path="res://art/ui/zoo_theme.tres" id="1_theme"]
[ext_resource type="Script" path="res://scripts/save_picker.gd" id="2_script"]

[sub_resource type="StyleBoxFlat" id="paper"]
content_margin_left = 22.0
content_margin_top = 18.0
content_margin_right = 22.0
content_margin_bottom = 18.0
bg_color = Color(0.937, 0.894, 0.769, 0.97)
